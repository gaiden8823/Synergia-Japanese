    except NameError:
        _rf_strtypes = (str,)

    def _renforge_ui_text_lookup(s):
        try:
            if isinstance(s, _rf_strtypes) and s in _renforge_ui_map:
                return _renforge_ui_map[s]
        except Exception:
            pass
