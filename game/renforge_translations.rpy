        u"{size=+25}{font=logotypejp_corpmin.ttf}{color=#E2D4D7}协同效应计划意外15天前{/color}{/font}{/size}": u"{size=+25}{font=logotypejp_corpmin.ttf}{color=#E2D4D7}シネルギア事件の15日前{/color}{/font}{/size}",
        u"{size=+25}{font=logotypejp_corpmin.ttf}{color=#E2D4D7}协同效应计划意外20天前{/color}{/font}{/size}": u"{size=+25}{font=logotypejp_corpmin.ttf}{color=#E2D4D7}シネルギア事件の20日前{/color}{/font}{/size}",
